# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/swastik_college


CLIENT_URL=http://localhost:5173

# SMTP settings for sending real invite emails (e.g. Gmail SMTP, SendGrid,
# Mailtrap for testing). If left unset, invite creation still works — the
# invite link is just returned in the API response instead of emailed, so
# local development doesn't require a real mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@swastikcollege.edu.np

# Server port
PORT=5000

# Secret used to sign admin login sessions (JWT) — change this in production
JWT_SECRET=change_this_to_a_long_random_string

# Used only once by `npm run seed` to create the first admin account
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@swastikcollege.edu.np
ADMIN_PASSWORD=ChangeMe123!

# Google AI Studio API key (free tier) — powers PDF embeddings + chat
# answers for "Chat with Admissions". Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# Timeout in minutes for how long to wait for an admin to respond before
HANDOFF_TIMEOUT_MINUTES=5
